{
  "name": "drawing-app",
  "version": "1.0.0",
  "description": "A TypeScript HTML5 Canvas drawing application with brush, eraser, fill, undo/redo, save, and load features.",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "bundle:browser": "esbuild src/main.ts --bundle --format=esm --outfile=src/main.browser.js",
    "build": "tsc && vite build",
    "lint": "tslint -p tsconfig.json",
    "test": "jest",
    "info": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/project-info.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-legacy": "^5.4.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.7.2"
  }
}
